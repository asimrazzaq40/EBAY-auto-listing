{
  "manifest_version": 3,
  "name": "AM eBay Listing Assistant",
  "version": "1.0.0",
  "description": "Semi-automated AliExpress to eBay AU listing assistant with password-protected popup and editor.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://*.ebay.com.au/*",
    "https://*.ebay.com/*",
    "https://ae-pic-a1.aliexpress-media.com/*",
    "https://ae01.alicdn.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "AM eBay Listing Assistant",
    "default_popup": "pages/popup.html"
  },
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/*",
        "https://*.aliexpress.us/*"
      ],
      "js": [
        "src/content/aliexpress-scraper.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ebay.com.au/*",
        "https://*.ebay.com/*"
      ],
      "js": [
        "src/content/ebay-variation-watcher.js",
        "src/content/ebay-autofill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon.png"
      ],
      "matches": [
        "https://*.ebay.com.au/*",
        "https://*.ebay.com/*"
      ]
    }
  ]
}
